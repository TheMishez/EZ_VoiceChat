{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZ VoiceChat",
  "version": "0.1.1",
  "identifier": "com.ezggco.voicechat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EZGGco",
    "shortDescription": "Low-latency voice chat for Mumble and TeamSpeak 3 servers",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
